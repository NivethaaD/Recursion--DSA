1. Pow(x, n)

class Solution:
    def cal(self, x, n):
        if n==0:
            return 1
        half = self.cal(x,n//2)
        if n%2==0:
            return half*half
        return x*half*half

    def myPow(self, x: float, n: int) -> float:
        sign = 0
        if n<0:
            sign = -1
            n = -1*n
        
        val = self.cal(x,n)
        if sign<0:
            return 1/val
        return val

2. Count Good Numbers

class Solution:
    def countGoodNumbers(self, n: int) -> int:
        MOD = 10**9 + 7
        half = n//2
        odd = half
        even = half

        if n % 2 != 0:
            even = half+1
        
        return (pow(5, even, MOD)*pow(4, odd, MOD))%MOD
        
3. Sort a stack

class Solution:
    def insertSortedWay(self, st, ele):
        if len(st) == 0 or st[-1]<ele:
            st.append(ele)
            return
        
        top = st.pop()
        self.insertSortedWay(st, ele)
        st.append(top)
        
    def sortStack(self, st):
        # code here
        if len(st)==0:
            return
        
        ele = st.pop()
        self.sortStack(st)
        self.insertSortedWay(st, ele)
        
4. Reverse a Stack

class Solution:
    def reverseFunc(self,st, ele):
        if len(st) == 0:
            st.append(ele)
            return

        top = st.pop()
        self.reverseFunc(st, ele)
        st.append(top)
    
    def reverseStack(self, st):
        if len(st)==0:
            return
        
        ele = st.pop()
        self.reverseStack(st)
        self.reverseFunc(st, ele)

5. Generate all the subsequences(Subset)

class Solution:
    def findAllSubsequence(self, ind, n, nums, ans, temp):
        if ind==n:
            ans.append(temp.copy())
            return
        
        temp.append(nums[ind])
        self.findAllSubsequence(ind+1, n, nums, ans, temp)
        temp.pop()
        self.findAllSubsequence(ind+1, n, nums, ans, temp)


    def subsets(self, nums: List[int]) -> List[List[int]]:
        ans = []
        n = len(nums)
        temp = []
        self.findAllSubsequence(0, n, nums, ans, temp)
        return ans

6.  Count Subsets with Sum K

from typing import List

def findSubseqSum(nums, ind, n, sum, k):
        if ind==n:
            if sum == k:
                return 1
            return 0
    
        take = findSubseqSum(nums, ind+1, n, sum+nums[ind], k)
        not_take = findSubseqSum(nums, ind+1, n, sum, k)
        return take+not_take

def findWays(nums: List[int], k: int) -> int:
    return findSubseqSum(nums, 0, len(nums), 0, k)

7. Combination Sum

class Solution:
    def solve(self, target, ind, candidates, temp, res):
        if target == 0:
            res.append(temp.copy())
            return
        if ind==len(candidates):
            return
        if target >= candidates[ind]:
            temp.append(candidates[ind])
            self.solve(target-candidates[ind], ind, candidates, temp, res)
            temp.pop()
        self.solve(target, ind+1, candidates, temp, res)
    
    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:
        temp = []
        res = []
        self.solve(target, 0, candidates, temp, res)
        return res
        
8. Generate Parentheses

class Solution:
    def solve(self, openPar,closePar, n, temp, res):
        if len(temp) == n*2:
            res.append(temp[:])
            return
        if openPar < n:
            self.solve(openPar+1,closePar, n, temp+'(', res)
        if closePar < openPar and closePar < n:
            self.solve(openPar,closePar+1, n, temp+')', res)
        
    def generateParenthesis(self, n: int) -> List[str]:
        res = []
        self.solve(0,0,n,"",res)
        return res

9. Subsets II

class Solution:
    def findAllSubsequence(self, ind, n, nums, ans, temp):
        if ind==n:
            ans.add(tuple(temp.copy()))
            return
        
        temp.append(nums[ind])
        self.findAllSubsequence(ind+1, n, nums, ans, temp)
        temp.pop()
        self.findAllSubsequence(ind+1, n, nums, ans, temp)

    def subsetsWithDup(self, nums: List[int]) -> List[List[int]]:
        nums.sort()
        ans = set()
        n = len(nums)
        temp = list()
        self.findAllSubsequence(0, n, nums, ans, temp)
        return sorted(list(ans))
