1. Pow(x, n)

class Solution:
    def cal(self, x, n):
        if n==0:
            return 1
        half = self.cal(x,n//2)
        if n%2==0:
            return half*half
        return x*half*half

    def myPow(self, x: float, n: int) -> float:
        sign = 0
        if n<0:
            sign = -1
            n = -1*n
        
        val = self.cal(x,n)
        if sign<0:
            return 1/val
        return val

2. Count Good Numbers

class Solution:
    def countGoodNumbers(self, n: int) -> int:
        MOD = 10**9 + 7
        half = n//2
        odd = half
        even = half

        if n % 2 != 0:
            even = half+1
        
        return (pow(5, even, MOD)*pow(4, odd, MOD))%MOD
        
3. Sort a stack

class Solution:
    def insertSortedWay(self, st, ele):
        if len(st) == 0 or st[-1]<ele:
            st.append(ele)
            return
        
        top = st.pop()
        self.insertSortedWay(st, ele)
        st.append(top)
        
    def sortStack(self, st):
        # code here
        if len(st)==0:
            return
        
        ele = st.pop()
        self.sortStack(st)
        self.insertSortedWay(st, ele)
        
4. Reverse a Stack

class Solution:
    def reverseFunc(self,st, ele):
        if len(st) == 0:
            st.append(ele)
            return

        top = st.pop()
        self.reverseFunc(st, ele)
        st.append(top)
    
    def reverseStack(self, st):
        if len(st)==0:
            return
        
        ele = st.pop()
        self.reverseStack(st)
        self.reverseFunc(st, ele)

5. Generate all the subsequences(Subset)

class Solution:
    def findAllSubsequence(self, ind, n, nums, ans, temp):
        if ind==n:
            ans.append(temp.copy())
            return
        
        temp.append(nums[ind])
        self.findAllSubsequence(ind+1, n, nums, ans, temp)
        temp.pop()
        self.findAllSubsequence(ind+1, n, nums, ans, temp)


    def subsets(self, nums: List[int]) -> List[List[int]]:
        ans = []
        n = len(nums)
        temp = []
        self.findAllSubsequence(0, n, nums, ans, temp)
        return ans
